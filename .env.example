# Copie ce fichier en .env puis remplis les valeurs.
# Le fichier .env ne doit jamais être versionné (il est dans .gitignore).

# Base de données PostgreSQL
POSTGRES_USER=album
POSTGRES_PASSWORD=change-me
POSTGRES_DB=album
# Dans Docker, le nom d'hôte est "db" (le nom du service), pas "localhost"
DATABASE_URL=postgresql://album:change-me@db:5432/album

# Redis (cache et tâches de fond)
REDIS_URL=redis://redis:6379

# Authentification Auth.js (lot 1)
# Adresse publique du site, utilisée pour les liens de connexion
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Adresse publique du site (URLs canoniques, sitemap, Open Graph)
PUBLIC_BASE_URL=http://localhost:3000

# APIs externes (lot 2)
LASTFM_API_KEY=
