# Copie ce fichier en .env puis remplis les valeurs.
# Le fichier .env ne doit jamais être versionné (il est dans .gitignore).

# Base de données PostgreSQL
POSTGRES_USER=album
POSTGRES_PASSWORD=change-me
POSTGRES_DB=album
# En dev, la base tourne dans Docker mais l'app dans WSL : on passe par localhost
DATABASE_URL=postgresql://album:change-me@localhost:5432/album

# Redis (cache et tâches de fond)
REDIS_URL=redis://localhost:6379

# Authentification Auth.js (lot 1)
# Adresse publique du site, utilisée pour les liens de connexion
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Envoi des e-mails (lien de vérification de l'adresse). Format : smtp://utilisateur:motdepasse@serveur:587
# Vide en développement : l'e-mail est alors affiché dans les logs (terminal de npm run dev).
SMTP_URL=
MAIL_FROM="Album <no-reply@example.com>"

# Adresse publique du site (URLs canoniques, sitemap, Open Graph)
PUBLIC_BASE_URL=http://localhost:3000
# "true" seulement quand le domaine est en ligne : sinon les moteurs de recherche n'indexent rien
SEO_INDEXING=false
# Code de vérification Google Search Console (balise meta, valeur de content=""), une fois le domaine en ligne
GOOGLE_SITE_VERIFICATION=

# Catalogue : ListenBrainz et MusicBrainz ne demandent pas de clé.
# Contact envoyé à MusicBrainz dans le User-Agent (recommandé par leur charte)
MUSICBRAINZ_CONTACT=

# Last.fm : écoutes affichées sur les fiches album (la rareté n'en dépend pas).
# Clé gratuite : https://www.last.fm/api/account/create, puis npm run import:lastfm
LASTFM_API_KEY=

# Pages légales (mentions légales, confidentialité, CGU) : obligatoires avant la mise en ligne
# Nom de l'éditeur du site (toi ou ta société)
LEGAL_PUBLISHER=
# Adresse où les joueurs écrivent pour leurs questions et leurs droits sur leurs données
LEGAL_CONTACT_EMAIL=
# Hébergeur : nom, adresse et téléphone
LEGAL_HOST=
