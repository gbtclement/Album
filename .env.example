# Modèle des deux fichiers de réglages, jamais versionnés (ils sont dans .gitignore) :
#   .env       = ton ordinateur (développement) : copie ce fichier en .env
#   .env.prod  = le serveur (production) : modifié sur ton ordinateur, puis envoyé avec deploy/envoyer-env.sh

# Base de données PostgreSQL
POSTGRES_USER=album
POSTGRES_PASSWORD=change-me
POSTGRES_DB=album
# En dev, la base tourne dans Docker mais l'app dans WSL : on passe par localhost
DATABASE_URL=postgresql://album:change-me@localhost:5432/album

# Redis (cache et tâches de fond)
REDIS_URL=redis://localhost:6379

# Authentification Auth.js (lot 1)
# Adresse publique du site, utilisée pour les liens de connexion
AUTH_URL=http://localhost:3000
AUTH_SECRET=

# Envoi des e-mails (vérification de l'adresse, mot de passe oublié, compte inactif) avec Brevo.
# Brevo > Paramètres > SMTP & API > onglet SMTP : serveur, port, identifiant (xxx@smtp-brevo.com) et une clé SMTP.
# SMTP_HOST vide en développement : l'e-mail est alors affiché dans les logs (terminal de npm run dev).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur : une adresse du domaine, déclaré dans Brevo (Expéditeurs, domaines > Domaines)
MAIL_FROM="Musicodex <no-reply@musicodex.fr>"

# Adresse publique du site (URLs canoniques, sitemap, Open Graph)
PUBLIC_BASE_URL=http://localhost:3000
# "true" seulement quand le domaine est en ligne : sinon les moteurs de recherche n'indexent rien
SEO_INDEXING=false
# Code de vérification Google Search Console (balise meta, valeur de content=""), une fois le domaine en ligne
GOOGLE_SITE_VERIFICATION=

# Catalogue : MusicBrainz ne demande pas de clé (Last.fm oui : LASTFM_API_KEY).
# Contact envoyé à MusicBrainz dans le User-Agent (recommandé par leur charte)
MUSICBRAINZ_CONTACT=

# Last.fm : écoutes affichées sur les fiches album (la rareté n'en dépend pas).
# Clé gratuite : https://www.last.fm/api/account/create, puis npm run import:lastfm
LASTFM_API_KEY=

# Pages légales (mentions légales, confidentialité, CGU) : obligatoires avant la mise en ligne
# Nom de l'éditeur du site (toi ou ta société)
LEGAL_PUBLISHER=
# Adresse où les joueurs écrivent pour leurs questions et leurs droits sur leurs données
LEGAL_CONTACT_EMAIL=
# Hébergeur : nom, adresse et téléphone
LEGAL_HOST=
# Conditions générales de vente (abonnement premium) : adresse et numéro SIRET du vendeur
LEGAL_SELLER=
# Médiateur de la consommation auquel tu as adhéré (obligatoire pour vendre à des particuliers) : nom et site
LEGAL_MEDIATOR=

# Paiement Stripe : abonnement premium (lot PAY1). Laisser vide tant que le paiement n'est pas ouvert.
# Clé secrète (Dashboard Stripe > Développeurs > Clés API). sk_test_... en test, sk_live_... en production. Ne jamais la partager.
STRIPE_SECRET_KEY=
# Secret de signature du webhook (whsec_...) : Dashboard > Développeurs > Webhooks, ou "stripe listen" en local
STRIPE_WEBHOOK_SECRET=
# Identifiant du prix de l'abonnement premium mensuel (price_...) : Dashboard > Catalogue de produits
STRIPE_PRICE_PREMIUM=

# Accès à la page /documentation : identifiant et mot de passe demandés par le navigateur.
# Une ligne au format .htpasswd (identifiant:empreinte bcrypt). Attention aux « $ » de l'empreinte :
#   dans .env (lu par Next.js)      : un \ devant chaque $  -> DOC_HTPASSWD=nom:\$2y\$10\$...
#   dans .env.prod (lu par Docker) : entre apostrophes      -> DOC_HTPASSWD='nom:$2y$10$...'
# Pour la créer : htpasswd -nbB identifiant motdepasse. Vide = documentation inaccessible.
DOC_HTPASSWD=

# Développement seulement : 1 = pioches du jour illimitées (bouton « Nouvelle pioche » une fois la pioche terminée),
# pour tester sans attendre minuit. Ignoré en production (NODE_ENV=production). Ne pas mettre dans .env.prod.
DRAW_REPLAY=
