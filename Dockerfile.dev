# Image de développement : les dépendances sont installées une fois, à la construction de l'image.
# Le code vit dans le conteneur et `docker compose watch` y recopie chaque fichier modifié :
# pas de dossier Windows monté, donc pas de faux changements détectés par Turbopack.
FROM node:22-alpine
WORKDIR /app
ENV NEXT_TELEMETRY_DISABLED=1
COPY package.json package-lock.json ./
RUN npm ci
COPY . .
EXPOSE 3000
CMD ["npm", "run", "dev", "--", "-H", "0.0.0.0"]
