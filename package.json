{
  "name": "album",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run migrate && next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "import:catalog": "tsx --env-file-if-exists=.env scripts/import-catalog.ts",
    "import:lastfm": "tsx --env-file-if-exists=.env scripts/import-lastfm.ts",
    "check:covers": "tsx --env-file-if-exists=.env scripts/check-covers.ts",
    "seed:demo": "tsx --env-file-if-exists=.env scripts/seed-demo.ts",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "ioredis": "^6.0.0",
    "lightweight-charts": "^5.2.1",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
